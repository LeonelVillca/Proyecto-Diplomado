# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:62532
API_PUBLIC_URL=http://localhost:3000

# Almacenamiento de imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Documentos privados (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mesachapaca-documentos
R2_ENDPOINT=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=backend_restaurantes
DB_SSL=false

# Usuario DDL separado, usado únicamente al aplicar migraciones o configurar
# el rol de ejecución. En producción DB_USER no debe ser propietario ni superusuario.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# Sincronización de esquema (SOLO en desarrollo: true)
DB_SYNCHRONIZE=false

# Autenticación JWT
# IMPORTANTE: Usar un secreto de al menos 64 caracteres aleatorios en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
PIN_HMAC_SECRET=
JWT_EXPIRES_IN=1h
# Los JWT duran 1 hora; la renovación autenticada mantiene un máximo absoluto de 7 días.

# CORS — Orígenes permitidos separados por comas
# Ejemplo: http://localhost:4200,https://mi-app.com
CORS_ORIGINS=http://localhost:4200

# Firebase Admin (verificación server-side del ID Token de Google)
# Completar con los valores de la cuenta de servicio de Firebase.
# El private key debe pegarse escapando los saltos de línea como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Correo transaccional por Brevo API (HTTPS)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Mesa Chapaca

# Solo para seed local explícito. No ejecutar contra datos reales.
ALLOW_DESTRUCTIVE_SEED=false
SEED_ADMIN_PASSWORD=
