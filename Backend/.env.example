# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:62532
API_PUBLIC_URL=http://localhost:3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=backend_restaurantes
DB_SSL=false

# Sincronización de esquema (SOLO en desarrollo: true)
DB_SYNCHRONIZE=false

# Autenticación JWT
# IMPORTANTE: Usar un secreto de al menos 64 caracteres aleatorios en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
PIN_HMAC_SECRET=
JWT_EXPIRES_IN=1h
# Los JWT duran 1 hora; la renovación autenticada mantiene un máximo absoluto de 7 días.

# CORS — Orígenes permitidos separados por comas
# Ejemplo: http://localhost:4200,https://mi-app.com
CORS_ORIGINS=http://localhost:4200

# Firebase Admin (verificación server-side del ID Token de Google)
# Completar con los valores de la cuenta de servicio de Firebase.
# El private key debe pegarse escapando los saltos de línea como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Configuración de correo Nodemailer
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Solo para seed local explícito. No ejecutar contra datos reales.
ALLOW_DESTRUCTIVE_SEED=false
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=
